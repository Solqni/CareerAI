APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=please-change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=careerai
POSTGRES_PASSWORD=careerai_password
POSTGRES_DB=careerai
DATABASE_URL=postgresql+asyncpg://careerai:careerai_password@localhost:5432/careerai

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=deepseek-embed
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5
